  from datetime import datetime
import math
import uuid


class Producto:
    """Representa un ítem dentro del catálogo del SIIA."""

    def __init__(
        self,
        sku: str,
        nombre: str,
        categoria: str,
        stock_actual: int,
        demanda_diaria: float,
        costo_pedido: float,
        costo_almacenamiento_anual: float,
        tiempo_entrega_dias: int,
        stock_seguridad: int = 0,
    ):
        self.sku = sku
        self.nombre = nombre
        self.categoria = categoria
        self.stock_actual = stock_actual
        self.demanda_diaria = demanda_diaria  # Demanda promedio diaria (d)
        self.costo_pedido = costo_pedido  # Costo por realizar un pedido (S)
        self.costo_almacenamiento_anual = (
            costo_almacenamiento_anual  # Costo anual de mantener unidad (H)
        )
        self.tiempo_entrega_dias = (
            tiempo_entrega_dias  # Lead time del proveedor (L)
        )
        self.stock_seguridad = stock_seguridad


class Movimiento:
    """Registra de forma inmutable las transacciones para garantizar la trazabilidad."""

    def __init__(
        self,
        sku: str,
        tipo: str,
        cantidad: int,
        origen_destino: str,
        usuario: str,
    ):
        self.id_transaccion = str(uuid.uuid4())[:8]
        self.timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        self.sku = sku
        self.tipo = tipo  # 'ENTRADA' o 'SALIDA'
        self.cantidad = cantidad
        self.origen_destino = origen_destino
        self.usuario = usuario

    def __str__(self):
        return f"[{self.timestamp}] ID: {self.id_transaccion} | {self.tipo:<7} | SKU: {self.sku} | Cant: {self.cantidad} | Ref: {self.origen_destino} | User: {self.usuario}"


class AlgoritmoOptimizacion:
    """Metodología de optimización basada en el modelo EOQ (Economic Order Quantity) y ROP (Reorder Point)."""

    @staticmethod
    def calcular_eoq(demanda_anual: float, S: float, H: float) -> int:
        """Calcula el Lote Económico de Compras (EOQ).

        Fórmula: sqrt((2 * D * S) / H)
        """
        if H <= 0 or demanda_anual <= 0:
            return 0
        eoq = math.sqrt((2 * demanda_anual * S) / H)
        return round(eoq)

    @staticmethod
    def calcular_punto_reorden(
        demanda_diaria: float, lead_time_dias: int, stock_seguridad: int
    ) -> int:
        """Calcula el Punto de Reorden (ROP).

        Fórmula: (d * L) + SS
        """
        return round((demanda_diaria * lead_time_dias) + stock_seguridad)


class GestorSIIA:
    """Controlador principal del Sistema Integral de Inventarios Automatizados."""

    def __init__(self):
        self.inventario = {}  # {sku: Producto}
        self.historial_movimientos = []

    def registrar_producto(self, producto: Producto):
        """Añade un nuevo producto al catálogo del sistema."""
        self.inventario[producto.sku] = producto

    def registrar_entrada(
        self,
        sku: str,
        cantidad: int,
        proveedor: str,
        usuario: str = "Sistema_Auto",
    ):
        """Registra el ingreso de mercancía en tiempo real."""
        if sku not in self.inventario:
            raise ValueError(f"El SKU '{sku}' no existe en el sistema.")

        self.inventario[sku].stock_actual += cantidad
        mov = Movimiento(sku, "ENTRADA", cantidad, proveedor, usuario)
        self.historial_movimientos.append(mov)
        return mov

    def registrar_salida(
        self,
        sku: str,
        cantidad: int,
        destino: str,
        usuario: str = "Sistema_Auto",
    ):
        """Registra la salida o distribución de inventario con validación de stock."""
        if sku not in self.inventario:
            raise ValueError(f"El SKU '{sku}' no existe en el sistema.")

        prod = self.inventario[sku]
        if prod.stock_actual < cantidad:
            raise ValueError(
                f"Stock insuficiente para {prod.nombre}. Disponible: {prod.stock_actual}, Solicitado: {cantidad}"
            )

        prod.stock_actual -= cantidad
        mov = Movimiento(sku, "SALIDA", cantidad, destino, usuario)
        self.historial_movimientos.append(mov)
        return mov

    def analizar_estado_optimizacion(self):
        """Aplica los algoritmos de optimización para evaluar el estado global del inventario."""
        reporte = []
        for sku, prod in self.inventario.items():
            demanda_anual = prod.demanda_diaria * 365
            eoq = AlgoritmoOptimizacion.calcular_eoq(
                demanda_anual,
                prod.costo_pedido,
                prod.costo_almacenamiento_anual,
            )
            rop = AlgoritmoOptimizacion.calcular_punto_reorden(
                prod.demanda_diaria,
                prod.tiempo_entrega_dias,
                prod.stock_seguridad,
            )

            necesita_reabastecimiento = prod.stock_actual <= rop

            reporte.append(
                {
                    "sku": sku,
                    "nombre": prod.nombre,
                    "stock_actual": prod.stock_actual,
                    "punto_reorden_rop": rop,
                    "lote_optimo_eoq": eoq,
                    "alerta_pedido": necesita_reabastecimiento,
                }
            )
        return reporte


